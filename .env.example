# ---------------- NapCat / OneBot ----------------
# NapCat 与 MCP 在同一台电脑时保持 127.0.0.1，不要把 3000 端口公开。
NAPCAT_HOST=http://127.0.0.1:3000
NAPCAT_TOKEN=replace_with_napcat_onebot_token

# 建议明确填写允许访问的群号，多个群号用英文逗号分隔。
ALLOWED_GROUPS=628101497

# 首次部署建议 true；确认无误后才改为 false。
READONLY_MODE=true
DISABLED_TOOLS=
NAPCAT_RESPONSE_MODE=compact

# ---------------- MCP transport ----------------
# stdio：Claude Desktop/Cline 等本机客户端
# streamable-http：RikkaHub 等远程客户端
MCP_TRANSPORT=streamable-http

# 仅本机测试可用 127.0.0.1。
# 给同一局域网/Tailscale 的 RikkaHub 使用时，推荐填写 Windows 的实际 LAN/Tailscale IP。
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=18080
MCP_HTTP_PATH=/mcp

# 远程监听时必填。RikkaHub 请求头填写 Authorization: Bearer <此值>。
MCP_BEARER_TOKEN=replace_with_a_different_long_random_token

# DNS rebinding 防护允许的 Host 请求头，多个值用英文逗号分隔。
# 绑定实际 IP 时通常会自动生成；绑定 0.0.0.0 时必须显式填写。
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

MCP_HTTP_STATELESS=false
MCP_HTTP_JSON_RESPONSE=false
MCP_HTTP_LOG_LEVEL=info
